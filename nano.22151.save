monitor.alsa.rules = [
  {
    matches = [
      {
        device.name = "~alsa_card.usb-XiiSound_Technology_Corporation_Fantech_Tamago_WHG01.*"
      }
    ]
    actions = {
      update-props = {
        api.alsa.soft-mixer = true
        api.alsa.ignore-dB = true
        api.alsa.enable-hw-volume = false
      }
    }
  }
]
